# Backend — Dev environment
# Copy to .env and fill in real values. Never commit .env.
#
# Database: SQLite (no Docker needed — file is created automatically on first run)
DATABASE_URL=sqlite+aiosqlite:///./engoal_lite_dev.db

# App secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT algorithm
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to true in development to enable SQL echo logging
DEBUG=false

# Comma-separated or JSON list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000"]
