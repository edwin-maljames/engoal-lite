# Backend — Test environment (E2E / post-merge)
# Copy to .env.test. Never commit .env.test.
#
# Database: Postgres running on local Mac (not Docker).
# One-time setup:
#   createuser -s test_user
#   psql -c "ALTER USER test_user WITH PASSWORD 'test_pwd';"
#   createdb -O test_user engoal_lite_test
DATABASE_URL=postgresql://test_user:test_pwd@localhost:5432/engoal_lite_test

# App secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
